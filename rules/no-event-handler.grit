engine biome(1.0)
language js(typescript, jsx)

or {
    `$state.$member` as $access where {
        $access <: within `$left && $right`,
        $left <: contains $state,
        $right <: contains $state,
        $access <: within JsIfStatement() as $if,
        $if <: within `$use_effect(() => { $body }, [$..., $state, $...])`,
        $use_effect <: or { `useEffect`, `React.useEffect` },
        $if <: within JsFunctionDeclaration() as $function,
        $function <: contains or {
            `const [$state, $_] = $use_state($...)`,
            `const [$state, $_] = $use_state<$state_type>($...)`
        },
        $use_state <: or { `useState`, `React.useState` },
        register_diagnostic(
            span = $access,
            message = "Avoid using state and an effect as an event handler. Run this logic in the event handler instead.",
            severity = "warn"
        )
    },
    or {
        JsFunctionDeclaration() as $function,
        JsArrowFunctionExpression() as $function
    } where {
        $function <: contains or {
            `$use_effect(() => { $body })`,
            `$use_effect(() => { $body }, [])`,
            `$use_effect(() => { $body }, [$..., $state, $...])`
        },
        $use_effect <: or { `useEffect`, `React.useEffect` },
        $body <: contains JsIfStatement() as $if until or {
            JsArrowFunctionExpression(),
            JsFunctionDeclaration(),
            JsFunctionExpression()
        },
        $function <: contains or {
            `const [$state, $_] = $use_state($...)`,
            `const [$state, $_] = $use_state<$state_type>($...)`,
            `let [$state, $_] = $use_state($...)`,
            `let [$state, $_] = $use_state<$state_type>($...)`
        },
        $use_state <: or { `useState`, `React.useState` },
        $if <: contains $state,
        $if <: not r"(?s).*if\s*\([^&]+\.[^&]+&&[^&]+\..*",
        register_diagnostic(
            span = $if,
            message = "Avoid using state and an effect as an event handler. Run this logic in the event handler instead.",
            severity = "warn"
        )
    },
    or {
        `function $name($props) { $component_body }`,
        `function $name($props: $props_type) { $component_body }`,
        `const $name = ($props) => { $component_body }`,
        `const $name = ($props: $props_type) => { $component_body }`
    } where {
        $component_body <: contains or {
            `$use_effect(() => { $body }, [$..., $dependency, $...])`
        },
        $use_effect <: or { `useEffect`, `React.useEffect` },
        $body <: contains JsIfStatement() as $if until or {
            JsArrowFunctionExpression(),
            JsFunctionDeclaration(),
            JsFunctionExpression()
        },
        $if <: contains $dependency,
        or {
            $props <: contains $dependency,
            $dependency <: contains $props
        },
        register_diagnostic(
            span = $if,
            message = "Avoid using props and an effect as an event handler. Move this logic to the parent.",
            severity = "warn"
        )
    },
    JsIfStatement() as $if where {
        $if <: within or {
            `function $name($props) { $component_body }`,
            `function $name($props: $props_type) { $component_body }`
        },
        $component_body <: contains `const $derived = $prop + $value`,
        $props <: contains $prop,
        $if <: within `$use_effect(() => { $body }, $dependencies)`,
        $use_effect <: or { `useEffect`, `React.useEffect` },
        $if <: contains $derived,
        register_diagnostic(
            span = $if,
            message = "Avoid using props and an effect as an event handler. Move this logic to the parent.",
            severity = "warn"
        )
    }
}
